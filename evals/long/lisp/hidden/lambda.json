{ "group": "lambda", "programs": [
  { "name": "called at once", "source": "(display ((lambda (x) (* x 2)) 21))", "expect": "42" },
  { "name": "named with define", "source": "(define add (lambda (a b) (+ a b))) (display (add 3 4))", "expect": "7" },
  { "name": "closure over a parameter", "source": "(define (make-adder n) (lambda (x) (+ x n))) (define add5 (make-adder 5)) (display (add5 10))", "expect": "15" },
  { "name": "counter", "source": "(define (make-counter) (let ((n 0)) (lambda () (set! n (+ n 1)) n))) (define c (make-counter)) (c) (c) (display (c))", "expect": "3" },
  { "name": "counters are independent", "source": "(define (make-counter) (let ((n 0)) (lambda () (set! n (+ n 1)) n))) (define a (make-counter)) (define b (make-counter)) (a) (a) (b) (display (a)) (display (b))", "expect": "32" },
  { "name": "global looked up at call time", "source": "(define x 1) (define (f) x) (define x 2) (display (f))", "expect": "2" },
  { "name": "lexical, not dynamic, scope", "source": "(define x 'global) (define (show-x) x) (define (test x) (show-x)) (display (test 'local))", "expect": "global" },
  { "name": "body returns its last value", "source": "(display ((lambda () 1 2 3)))", "expect": "3" },
  { "name": "takes a function", "source": "(define (twice f) (lambda (x) (f (f x)))) (display ((twice (lambda (n) (* n 3))) 2))", "expect": "18" },
  { "name": "is a procedure", "source": "(display (procedure? (lambda (x) x)))", "expect": "#t" },
  { "name": "curried builtin", "source": "(define (curry f) (lambda (a) (lambda (b) (f a b)))) (display (((curry +) 3) 4))", "expect": "7" },
  { "name": "three levels of closure", "source": "(define (outer a) (lambda (b) (lambda (c) (list a b c)))) (display (((outer 1) 2) 3))", "expect": "(1 2 3)" },
  { "name": "closures made by map", "source": "(define fs (map (lambda (n) (lambda () (* n n))) '(1 2 3))) (display (map (lambda (f) (f)) fs))", "expect": "(1 4 9)" }
] }
